{
    "name": "DDTankAuto",
    "custom_title": "DDTankAuto v2.1.0",
    "version": "v2.1.0",
    "url": "https://github.com/Tziheng/DDTankAuto",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "window_regex": "^新弹弹堂$",
                "screencap": 2,
                "input": 1
            }
        }
    ],
    "resource": [
        {
            "name": "小程序版本",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "{PROJECT_DIR}/python/python.exe",
        "child_args": [
            "-u",
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "task": [
        {
            "name": "测试agent",
            "entry": "测试agent",
            "doc": "测试功能"
        },
        {
            "name": "飞飞乐答案提示器",
            "entry": "飞飞乐",
            "doc": "该任务用于提示飞飞乐题目答案。题库位于 resource/text/flyquestion.txt, 可自行按原格式导入新题。",
            "option": [
                "飞飞乐持续时间"
            ]
        },
        {
            "name": "弹弹学院自动扫荡（正在开发中）",
            "entry": "弹弹学院",
            "doc": "功能即将上线，敬请期待！"
        },
        {
            "name": "竞技场自埋",
            "entry": "竞技场",
            "doc": "该任务用于自由战或者联赛自动挂机。\n高分段误用！重视信誉分者误用！\n可运行该任务的起始页面如下：游戏主界面，竞技大厅主界面，房间界面。",
            "option": [
                "活力低于不再执行竞技场",
                "选择竞技场模式"
            ]
        },
        {
            "name": "弹弹选秀",
            "entry": "弹弹选秀",
            "doc": "该任务用于进行弹弹选秀的自动化操作。\n会自动获取当前玩家的参选装扮，并在选秀投票页面中找到相似的装扮进行投票。\n可运行该任务的起始页面如下：游戏主界面，弹弹选秀主界面，时尚搭配赛界面。\n不选择截图自己装扮将沿用最后一次开启时的装扮进行投票。\n启动快速刷新有轻微可能被邀请界面打断。",
            "option": [
                "是否截图自己装扮",
                "是否启动快速刷新",
                "相似度最低值",
                "是否点赞",
                "持续时间"
            ]
        },
        {
            "name": "启动游戏",
            "entry": "启动游戏",
            "doc": "该任务用于登录游戏，并进入游戏主界面，（一般情况下，必选）。"
        },
        {
            "name": "领取福利",
            "entry": "领取福利",
            "doc": "该任务用于领取福利，包含每日签到、占卜、在线奖励、活力领取、奖励找回（只找回50%选项的）"
        },
        {
            "name": "多人副本自动扫荡",
            "entry": "多人副本",
            "option": [
                "副本关卡",
                "副本难度",
                "开启BOSS战",
                "活力低于不再执行多人副本",
                "是否额外翻牌",
                "是否自动邀请机器人",
                "开始战斗的最低房间人数"
            ],
            "doc": "该任务用于进行多人副本的自动化操作。\n可运行该任务的起始页面如下：游戏主界面，远征码头界面，多人副本选择界面，副本房间界面\n该任务自动战斗默认智能托管，可以手动取消并接管战斗。\n当免费快捷邀请次数使用完时，如果你有充足的小喇叭，会自动使用小喇叭快捷邀请。"
        }
    ],
    "option": {
        "飞飞乐持续时间": {
            "cases": [
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "飞飞乐": {
                            "custom_action_param": {
                                "duration": 600
                            }
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "飞飞乐": {
                            "custom_action_param": {
                                "duration": 1800
                            }
                        }
                    }
                },
                {
                    "name": "60分钟",
                    "pipeline_override": {
                        "飞飞乐": {
                            "custom_action_param": {
                                "duration": 3600
                            }
                        }
                    }
                }
            ],
            "default_case": "30分钟"
        },
        "是否点赞": {
            "cases": [
                {
                    "name": "点赞",
                    "pipeline_override": {}
                },
                {
                    "name": "不做任何操作",
                    "pipeline_override": {
                        "弹弹选秀-点击喜欢截图": {
                            "custom_action_param": {
                                "target": [
                                    0,
                                    0
                                ]
                            }
                        }
                    }
                }
            ],
            "default_case": "不保存"
        },
        "是否启动快速刷新": {
            "cases": [
                {
                    "name": "启动",
                    "pipeline_override": {
                        "弹弹选秀-退出重进当前界面": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "不启动",
                    "pipeline_override": {
                        "弹弹选秀-退出重进当前界面": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "选择竞技场模式": {
            "cases": [
                {
                    "name": "自由战",
                    "pipeline_override": {}
                },
                {
                    "name": "黄金联赛",
                    "pipeline_override": {
                        "竞技场-点击自由战": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "活力低于不再执行竞技场": {
            "cases": [
                {
                    "name": "无限次",
                    "pipeline_override": {
                        "竞技场-活力低于不再执行": {
                            "expected": "无限次"
                        }
                    }
                },
                {
                    "name": "小于10",
                    "pipeline_override": {
                        "竞技场-活力低于不再执行": {
                            "expected": "^[0-9]\/200$"
                        }
                    }
                },
                {
                    "name": "小于20",
                    "pipeline_override": {
                        "竞技场-活力低于不再执行": {
                            "expected": "^([0-1]?[0-9])\/200$"
