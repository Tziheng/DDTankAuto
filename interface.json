{
    "name": "DDTankAuto",
    "custom_title": "DDTankAuto v2.1.3",
    "version": "v2.1.3",
    "url": "https://github.com/Tziheng/DDTankAuto",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "window_regex": "^新弹弹堂$",
                "screencap": 2,
                "input": 1
            }
        }
    ],
    "resource": [
        {
            "name": "小程序版本",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "{PROJECT_DIR}/python/python.exe",
        "child_args": [
            "-u",
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "task": [
        {
            "name": "自动秘境",
            "entry": "秘境agent",
            "doc": ""
        },
        {
            "name": "农场自动偷菜",
            "entry": "农场自动偷菜agent",
            "doc": "该任务用于自动偷菜。\n可运行该任务的起始页面如下：游戏主界面，农场界面。"
        },
        {
            "name": "蝶妖任务",
            "entry": "蝶妖任务",
            "doc": "每隔15分钟自动领取一次蝶妖奖励，并且执行下一次蝶妖派遣。\n可运行该任务的起始页面如下：游戏主界面，伴侣界面，，蝶妖森林界面。"
        },
        {
            "name": "测试agent",
            "entry": "测试agent",
            "doc": "测试功能"
        },
        {
            "name": "飞飞乐答案提示器",
            "entry": "飞飞乐",
            "doc": "该任务用于提示飞飞乐题目答案。\n题库位于 resource/text/flyquestion.csv, 可以用记事本打开，可以自行按原格式导入新题。",
            "option": [
                "飞飞乐持续时间"
            ]
        },
        {
            "name": "竞技场自埋",
            "entry": "竞技场agent",
            "doc": "该任务用于自由战或者联赛自动挂机。\n高分段误用！重视信誉分者误用！\n可运行该任务的起始页面如下：游戏主界面，竞技大厅主界面，房间界面。",
            "option": [
                "竞技场执行次数",
                "选择竞技场模式"
            ]
        },
        {
            "name": "启动游戏",
            "entry": "启动游戏",
            "doc": "该任务用于登录游戏，并进入游戏主界面，（一般情况下，必选）。"
        },
        {
            "name": "领取福利",
            "entry": "领取福利",
            "doc": "该任务用于领取福利，包含每日签到、占卜、在线奖励、活力领取、奖励找回（只找回50%选项的）"
        },
        {
            "name": "多人副本自动扫荡",
            "entry": "多人副本agent",
            "option": [
                "副本关卡",
                "副本难度",
                "开启BOSS战",
                "多人副本通过关卡数",
                "是否自动邀请机器人",
                "开始战斗的最低房间人数"
            ],
            "doc": "该任务用于进行多人副本的自动化操作。\n可运行该任务的起始页面如下：游戏主界面，远征码头界面，多人副本选择界面，副本房间界面\n该任务自动战斗默认智能托管，可以手动取消并接管战斗。\n当免费快捷邀请次数使用完时，如果你有充足的小喇叭，会自动使用小喇叭快捷邀请。"
        }
    ],
