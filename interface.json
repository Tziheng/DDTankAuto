                {
                    "name": "小于80",
                    "pipeline_override": {
                        "竞技场-活力低于不再执行": {
                            "expected": "^([0-7]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于90",
                    "pipeline_override": {
                        "竞技场-活力低于不再执行": {
                            "expected": "^([0-8]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于100",
                    "pipeline_override": {
                        "竞技场-活力低于不再执行": {
                            "expected": "^([0-9]?[0-9])\/200$"
                        }
                    }
                }
            ],
            "default_case": "小于20"
        },
        "是否截图自己装扮": {
            "cases": [
                {
                    "name": "是",
                    "pipeline_override": {
                        "弹弹选秀-点击修改搭配": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "否",
                    "pipeline_override": {
                        "弹弹选秀-点击修改搭配": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
