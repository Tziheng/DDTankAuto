{
    "name": "DDTankAuto",
    "version": "v1.1.0",
    "url": "https://github.com/Tziheng/DDTankAuto",
    "custom_title": "DDTankAuto",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "window_regex": "^新弹弹堂$",
                "screencap": 2,
                "input": 1
            }
        }
    ],
    "resource": [
        {
            "name": "小程序版本",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        }
    ],
    "task": [
        {
            "name": "弹弹选秀（测试）",
            "entry": "弹弹选秀",
            "doc": "该任务用于进行弹弹选秀的自动化操作。\n会自动获取当前玩家的参选装扮，并在选秀投票页面中找到相似的装扮进行投票。",
            "option": [
                "持续时间"
            ]
        },
        {
            "name": "启动游戏",
            "entry": "启动游戏",
            "doc": "该任务用于登录游戏，并进入游戏主界面，（一般情况下，必选）。"
        },
        {
            "name": "领取福利",
            "entry": "领取福利",
            "doc": "该任务用于领取福利，包含每日签到、占卜、在线奖励、活力领取、奖励找回（只找回50%选项的）"
        },
        {
            "name": "多人副本自动扫荡",
            "entry": "多人副本",
            "option": [
                "副本关卡",
                "副本难度",
                "开启BOSS战",
                "活力低于不再执行",
                "是否额外翻牌",
                "是否自动邀请机器人",
                "开始战斗的最低房间人数"
            ],
            "doc": "该任务用于进行多人副本的自动化操作。\n可运行该任务的起始页面如下：游戏主界面，远征码头界面，多人副本选择界面，副本房间界面\n该任务目前只使用于房主，不支持非房主。\n该任务自动战斗默认智能托管，可以手动取消并接管战斗。\n房间中进入其他非机器人，如果该玩家在2分钟内及时准备，对该任务无影响，否则将退出房间并重新创建房间。\n开启BOSS战可以跳过一些第一关不友好的关卡，例如智能托管可能无法通过龙巢之战1。"
        },
        {
            "name": "弹弹学院自动扫荡（正在开发中）",
            "entry": "弹弹学院",
            "doc": "功能即将上线，敬请期待！"
        }
    ],
    "option": {
        "持续时间": {
            "cases": [
                {
                    "name": "1小时",
                    "pipeline_override": {
                        "弹弹选秀-识别": {
                            "timeout": 3600000
                        }
                    }
                },
                {
                    "name": "3小时",
                    "pipeline_override": {
                        "弹弹选秀-识别": {
                            "timeout": 10800000
                        }
                    }
                },
                {
                    "name": "6小时",
                    "pipeline_override": {
                        "弹弹选秀-识别": {
                            "timeout": 21600000
                        }
                    }
                },
                {
                    "name": "12小时",
                    "pipeline_override": {
                        "弹弹选秀-识别": {
                            "timeout": 43200000
                        }
                    }
                }
            ]
        },
        "开启BOSS战": {
            "cases": [
                {
                    "name": "开启",
                    "pipeline_override": {
                        "多人副本-是否开启BOSS战": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "不开启",
                    "pipeline_override": {
                        "多人副本-是否开启BOSS战": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "不开启"
        },
        "开始战斗的最低房间人数": {
            "cases": [
                {
                    "name": "1人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 3
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 3
                        }
                    }
                },
                {
                    "name": "2人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 2
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 2
                        }
                    }
                },
                {
                    "name": "3人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 1
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 1
                        }
                    }
                },
                {
                    "name": "4人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 0
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 0
                        }
                    }
                }
            ],
            "default_case": "2人"
        },
        "是否额外翻牌": {
            "cases": [
                {
                    "name": "额外翻牌",
                    "pipeline_override": {
                        "多人副本-额外翻牌": {
                            "action": "Click"
                        }
                    }
                },
                {
                    "name": "不额外翻牌",
                    "pipeline_override": {}
                }
            ],
            "default_case": "额外翻牌"
        },
        "是否自动邀请机器人": {
            "cases": [
                {
                    "name": "邀请",
                    "pipeline_override": {
                        "多人副本-根据房间空位是否邀请机器人": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "不邀请",
                    "pipeline_override": {
                        "多人副本-根据房间空位是否邀请机器人": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "邀请"
        },
        "活力低于不再执行": {
            "cases": [
                {
                    "name": "小于10",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^[0-9]\/200$"
                        }
                    }
                },
                {
                    "name": "小于20",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-1]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于30",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-2]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于40",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-3]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于50",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-4]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于60",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-5]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于70",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-6]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于80",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-7]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于90",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-8]?[0-9])\/200$"
                        }
                    }
                },
                {
                    "name": "小于100",
                    "pipeline_override": {
                        "多人副本-活力低于不再执行": {
                            "expected": "^([0-9]?[0-9])\/200$"
                        }
                    }
                }
            ],
            "default_case": "小于20"
        },
        "副本关卡": {
            "cases": [
                {
                    "name": "魔蚁之巢",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "魔蚁之巢"
                        }
                    }
                },
                {
                    "name": "小鸡快跑",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "小鸡快跑"
                        }
                    }
                },
                {
                    "name": "啵咕王城",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "啵咕王城"
                        }
                    }
                },
                {
                    "name": "邪神部落",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "邪神部落"
                        }
                    }
                },
                {
                    "name": "黑暗堡垒",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "黑暗堡垒"
                        }
                    }
                },
                {
                    "name": "龙巢之战",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "龙巢之战"
                        }
                    }
                },
                {
                    "name": "啵咕运动会",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "啵咕运动会"
                        }
                    }
                }
            ],
            "default_case": "啵咕运动会"
        },
        "副本难度": {
            "cases": [
                {
                    "name": "困难",
                    "pipeline_override": {
                        "多人副本-选择副本难度": {
                            "target": [
                                550,
                                560,
                                0,
                                0
                            ]
                        }
                    }
                },
                {
                    "name": "普通",
                    "pipeline_override": {
                        "多人副本-选择副本难度": {
                            "target": [
                                430,
                                560,
                                0,
                                0
                            ]
                        }
                    }
                },
                {
                    "name": "简单",
                    "pipeline_override": {
                        "多人副本-选择副本难度": {
                            "target": [
                                310,
                                560,
                                7,
                                3
                            ]
                        }
                    }
                }
            ],
            "default_case": "困难"
        }
    }
}