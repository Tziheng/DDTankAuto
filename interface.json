{
    "contact": "CONTACT",
    "license": "LICENSE",
    "name": "DDTankAuto",
    "custom_title": "DDTankAuto v3.0.1",
    "version": "v3.0.1",
    "icon": "{PROJECT_DIR}/icon.png",
    "github": "https://github.com/Tziheng/DDTankAuto",
    "interface_version": 2,
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "window_regex": "^新弹弹堂$",
                "screencap": "PrintWindow",
                "mouse": "SendMessageWithCursorPos",
                "keyboard": "SendMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "小程序版本",
            "path": [
                "{PROJECT_DIR}/resource"
            ],
            "controller": [
                "桌面端"
            ]
        }
    ],
    "agent": {
        "child_exec": "{PROJECT_DIR}/python/python.exe",
        "child_args": [
            "-u",
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "task": [
        {
            "name": "连点器",
            "entry": "连点器agent",
            "description": "按下按键后，会在当前鼠标所在位置连点，松开按键后停止连点。",
            "option": [
                "连点参数"
            ],
            "default_check": false
        },
        {
            "name": "自动秘境（开发中）",
            "entry": "秘境agent",
            "description": "",
            "default_check": false
        },
        {
            "name": "农场自动偷菜（开发中）",
            "entry": "农场自动偷菜agent",
            "description": "<span style=\"color:darkgray;font-size:15px\">该任务用于自动偷菜。</span>\n<span style=\"color:orange;font-size:15px\">可运行该任务的起始页面如下：游戏主界面，农场界面。</span>",
            "default_check": false
        },
        {
            "name": "蝶妖任务",
            "entry": "蝶妖任务",
            "description": "<span style=\"color:darkgray;font-size:15px\">每隔15分钟自动领取一次蝶妖奖励，并且执行下一次蝶妖派遣。</span>\n<span style=\"color:orange;font-size:15px\">可运行该任务的起始页面如下：游戏主界面，伴侣界面，蝶妖森林界面。</span>",
            "default_check": false
        },
        {
            "name": "飞飞乐答案提示器",
            "entry": "飞飞乐",
            "description": "<span style=\"color:darkgray;font-size:15px\">该任务用于提示飞飞乐题目答案。</span>\n<span style=\"color:orange;font-size:15px\">题库位于 resource/text/flyquestion.csv, 可以用记事本打开，可以自行按原格式导入新题。</span>\n<span style=\"color:red;font-size:15px\">如果该助手没有识别出题目，大概率是因为现有题库没有收录该题，可以自行收录，或者联系作者提交新题。</span>",
            "option": [
                "飞飞乐持续时间"
            ],
            "default_check": false
        },
        {
            "name": "竞技场自埋",
            "entry": "竞技场agent",
            "description": "<span style=\"color:darkgray;font-size:15px\">该任务用于自由战或者联赛自动挂机。</span>\n<span style=\"color:orange;font-size:15px\">可运行该任务的起始页面如下：游戏主界面，竞技大厅主界面，房间界面。</span>\n<span style=\"color:red;font-size:15px\">⚠高分段误用！重视信誉分者误用！</span>",
            "option": [
                "竞技场执行次数",
                "选择竞技场模式"
            ],
            "default_check": false
        },
        {
            "name": "启动游戏",
            "entry": "启动游戏",
            "description": "<span style=\"color:darkgray;font-size:15px\">该任务用于登录游戏，并进入游戏主界面。</span>",
            "default_check": false
        },
        {
            "name": "领取福利",
            "entry": "领取福利",
            "description": "<span style=\"color:darkgray;font-size:15px\">该任务用于领取福利，包含每日签到、占卜、在线奖励、活力领取、奖励找回（只找回50%选项的）</span>",
            "default_check": false
        },
        {
            "name": "多人副本自动扫荡",
            "entry": "多人副本agent",
            "option": [
                "副本关卡",
                "副本难度",
                "开启BOSS战",
                "多人副本通过关卡数",
                "是否自动邀请机器人",
                "开始战斗的最低房间人数"
            ],
            "description": "<span style=\"color:darkgray;font-size:15px\">该任务用于进行多人副本的自动化操作。</span>\n<span style=\"color:orange;font-size:15px\">可运行该任务的起始页面如下：游戏主界面，远征码头界面，多人副本选择界面，副本房间界面</span>\n<span style=\"color:red;font-size:15px\">⚠刷荣誉值时，注意多人副本每日有100次通关限制。</span>",
            "default_check": true
        }
    ],
    "option": {
        "连点参数": {
            "type": "input",
            "label": "连点触发按键",
            "inputs": [
                {
                    "name": "触发按键",
                    "pipeline_type": "string",
                    "default": "`"
                },
                {
                    "name": "连点间隔（毫秒）",
                    "pipeline_type": "int",
                    "default": "100",
                    "verify": "^[1-9]\\d*$"
                }
            ],
            "pipeline_override": {
                "连点器agent": {
                    "custom_action_param": {
                        "key": "{触发按键}",
                        "period": "{连点间隔（毫秒）}"
                    }
                }
            }
        },
        "多人副本通过关卡数": {
            "type": "input",
            "label": "通过关卡数",
            "description": "例如通过小鸡快跑-1与小鸡快跑-2时记作通过2次",
            "inputs": [
                {
                    "name": "通过关卡数",
                    "pipeline_type": "int",
                    "default": "10",
                    "verify": "^[1-9]\\d$"
                }
            ],
            "pipeline_override": {
                "多人副本agent": {
                    "custom_action_param": {
                        "mode": 1,
                        "times": "{通过关卡数}"
                    }
                }
            }
        },
        "竞技场执行次数": {
            "type": "input",
            "label": "作战次数",
            "inputs": [
                {
                    "name": "作战次数",
                    "pipeline_type": "int",
                    "default": "10",
                    "verify": "^[1-9]\\d$"
                }
            ],
            "pipeline_override": {
                "竞技场agent": {
                    "action": "Custom",
                    "custom_action": "FightAgent",
                    "custom_action_param": {
                        "mode": 0,
                        "times": "{作战次数}"
                    }
                }
            }
        },
        "飞飞乐持续时间": {
            "type": "select",
            "label": "持续时间",
            "cases": [
                {
                    "name": "10分钟",
                    "pipeline_override": {
                        "飞飞乐": {
                            "custom_action_param": {
                                "duration": 600
                            }
                        }
                    }
                },
                {
                    "name": "20分钟",
                    "pipeline_override": {
                        "飞飞乐": {
                            "custom_action_param": {
                                "duration": 1200
                            }
                        }
                    }
                },
                {
                    "name": "30分钟",
                    "pipeline_override": {
                        "飞飞乐": {
                            "custom_action_param": {
                                "duration": 1800
                            }
                        }
                    }
                }
            ],
            "default_case": "30分钟"
        },
        "选择竞技场模式": {
            "type": "select",
            "label": "模式",
            "cases": [
                {
                    "name": "自由战",
                    "pipeline_override": {}
                },
                {
                    "name": "黄金联赛",
                    "pipeline_override": {
                        "竞技场-点击自由战": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "开启BOSS战": {
            "type": "select",
            "label": "开启BOSS战",
            "description": "房主将自动花费点卷开启BOSS战",
            "cases": [
                {
                    "name": "开启",
                    "pipeline_override": {
                        "多人副本-是否开启BOSS战": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "不开启",
                    "pipeline_override": {
                        "多人副本-是否开启BOSS战": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "不开启"
        },
        "开始战斗的最低房间人数": {
            "type": "select",
            "label": "满足人数时开始战斗",
            "description": "当房间人数大于等于该值时，将点击准备/开始战斗",
            "cases": [
                {
                    "name": "1人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 3
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 3
                        }
                    }
                },
                {
                    "name": "2人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 2
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 2
                        }
                    }
                },
                {
                    "name": "3人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 1
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 1
                        }
                    }
                },
                {
                    "name": "4人",
                    "pipeline_override": {
                        "多人副本-点击开始游戏": {
                            "index": 0
                        },
                        "多人副本-根据房间空位是否邀请机器人": {
                            "index": 0
                        }
                    }
                }
            ],
            "default_case": "2人"
        },
        "是否自动邀请机器人": {
            "type": "select",
            "label": "自动邀请机器人",
            "description": "房间人数不足时，将自动邀请机器人进入房间",
            "cases": [
                {
                    "name": "邀请",
                    "pipeline_override": {
                        "多人副本-根据房间空位是否邀请机器人": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "不邀请",
                    "pipeline_override": {
                        "多人副本-根据房间空位是否邀请机器人": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "邀请"
        },
        "副本关卡": {
            "type": "select",
            "label": "副本关卡",
            "description": "已位于房间内时，优先以房间关卡为准",
            "cases": [
                {
                    "name": "魔蚁之巢",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "魔蚁之巢"
                        }
                    }
                },
                {
                    "name": "小鸡快跑",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "小鸡快跑"
                        }
                    }
                },
                {
                    "name": "啵咕王城",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "啵咕王城"
                        }
                    }
                },
                {
                    "name": "邪神部落",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "邪神部落"
                        }
                    }
                },
                {
                    "name": "黑暗堡垒",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "黑暗堡垒"
                        }
                    }
                },
                {
                    "name": "龙巢之战",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "龙巢之战"
                        }
                    }
                },
                {
                    "name": "啵咕运动会",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "啵咕运动会"
                        }
                    }
                },
                {
                    "name": "时空漩涡",
                    "pipeline_override": {
                        "多人副本-搜寻副本": {
                            "expected": "时空漩涡"
                        }
                    }
                }
            ],
            "default_case": "啵咕运动会"
        },
        "副本难度": {
            "type": "select",
            "label": "副本难度",
            "cases": [
                {
                    "name": "困难",
                    "pipeline_override": {
                        "多人副本-选择副本难度": {
                            "target": [
                                550,
                                560,
                                0,
                                0
                            ]
                        }
                    }
                },
                {
                    "name": "普通",
                    "pipeline_override": {
                        "多人副本-选择副本难度": {
                            "target": [
                                430,
                                560,
                                0,
                                0
                            ]
                        }
                    }
                },
                {
                    "name": "简单",
                    "pipeline_override": {
                        "多人副本-选择副本难度": {
                            "target": [
                                310,
                                560,
                                7,
                                3
                            ]
                        }
                    }
                }
            ],
            "default_case": "困难"
        }
    }
}